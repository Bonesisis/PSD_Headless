# Optional defaults; paths relative to the current working directory.
PSHL_TEMPLATE_DIR=./assets/templates
PSHL_OUTPUT_DIR=./out
# Explicit font override; empty means exact PostScript-name discovery.
PSHL_FONT_PATH=
PSHL_WORKERS=1
PSHL_HOST=127.0.0.1
PSHL_PORT=8000
# Required when binding to non-loopback interfaces; use a random secret.
PSHL_API_KEY=
# Extra allowed HTTP hostnames, comma-separated; never use a wildcard.
PSHL_ALLOWED_HOSTS=
# Durable queue and private previews: local disk, never a network share.
# Use the same absolute directory for CLI and server processes.
PSHL_STATE_DIR=./.pshl-state
# Per-job options (format, shrink, styles, fonts, background) live in the job file.

# Optional PhotoCraft adapter. Operator-installed CLI and offline Docker runtime.
# Prefer an immutable Docker image ID; no downloads are triggered by the app.
PSHL_PHOTOCRAFT_CLI=
PSHL_PHOTOCRAFT_SHA256=
PSHL_PHOTOCRAFT_IMAGE=

# Optional editorial planner; disabled by default. No vendor SDK required.
# Supported protocols: disabled, ollama, chat-completions.
PSHL_PLANNER_PROTOCOL=disabled
PSHL_PLANNER_URL=
PSHL_PLANNER_MODEL=
# Inject PSHL_PLANNER_KEY into the server process via your credential manager.
# Never put the key in this file, job JSON, the browser, or Git.
